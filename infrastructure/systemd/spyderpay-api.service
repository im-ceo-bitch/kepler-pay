[Unit]
Description=SpyderPay isolated hardened pre-license API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=spyderpay
Group=spyderpay
WorkingDirectory=/opt/spyderpay
EnvironmentFile=/etc/spyderpay/runtime.env
Environment=SPYDERPAY_ENV=prelicense
Environment=SPYDERPAY_HARDENED=yes
Environment=SPYDERPAY_ALLOW_SANDBOX_CREDIT=no
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/spyderpay/venv/bin/python -m spyderpay_core.postgres.api_v3 --hardened
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=128
MemoryMax=768M
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
