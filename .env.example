# prelicense only; values are references, not actual credentials.
SPYDERPAY_ENV=prelicense
SPYDERPAY_PG_DSN=postgresql://spyderpay_runtime_login:<secret>@127.0.0.1:5432/spyderpay
SPYDERPAY_ALLOW_SANDBOX_CREDIT=no
# SPYDERPAY_SERVICE_KEYS_JSON (server-only secret manager)
# SPYDERPAY_OIDC_JSON (issuer, audience, client_id, mfa_acr_values, public jwks)
# SPYDERPAY_IDENTITY_ADMIN_DSN (separate admin process, NEVER provided to API)
# Optional POS Ed25519 sandbox keyring: SPYDERPAY_POS_KEYS_JSON (server-only).
# Restore CLI: SPYDERPAY_BACKUP_TRUSTED_PUBLIC_B64 and SPYDERPAY_RESTORE_PG_DSN.

# Hardened pre-license profile: requires TLS verify-full, gssencmode=disable,
# target_session_attrs=read-write, absolute sslrootcert, named DB and user.
# SPYDERPAY_HARDENED=yes
# SPYDERPAY_INCIDENT_DSN: separate named incident login; never put in API.
# Backup process only: SPYDERPAY_BACKUP_PGSERVICE, PGSERVICEFILE, PGPASSFILE,
# SPYDERPAY_BACKUP_AGE_RECIPIENT, SPYDERPAY_BACKUP_SIGNER_JSON,
# SPYDERPAY_BACKUP_TRUSTED_PUBLIC_B64. Never share backup credentials with API.

# Dedicated POS and monitor hosts only (see infrastructure/operations/acceptance-v10.md).
# Never provision monitoring or POS credentials in the API process.
